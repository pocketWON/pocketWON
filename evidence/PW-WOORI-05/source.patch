+
+    const flow = section('flow', '저장된 돈 흐름');
+    flow.append(el('p', 'pw-report-muted pw-type-caption', '저장된 집계 · 기간 확인 안 됨'));
+    const values = el('dl', 'pw-report-flow-values');
